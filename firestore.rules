rules_version = '2';

// Only signed-in users with a verified email that has a document in /members may use the app.
// Members are added by hand in the Firebase console (Firestore → members → document id = email).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(email()));
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Everyone signed in may check their own membership; nobody may change it from the app.
    match /members/{memberEmail} {
      allow get: if signedIn() && email() == memberEmail;
    }

    match /recipes/{recipeId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && isString(request.resource.data.name, 200)
        && request.resource.data.name.size() > 0
        && request.resource.data.servings is int
        && request.resource.data.servings > 0
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() <= 200
        && request.resource.data.tags is list
        && isString(request.resource.data.instructions, 20000)
        && isString(request.resource.data.sourceUrl, 2000);
    }

    // A planned meal, if there is one: `cooked` and what cooking it took (`taken`) are optional.
    function isMealOrMissing(data, meal) {
      return !(meal in data) || (
        data[meal] is map
        && (!('cooked' in data[meal]) || data[meal].cooked is bool)
        && (!('taken' in data[meal]) || (data[meal].taken is list && data[meal].taken.size() <= 200))
      );
    }

    // One document per day, id YYYY-MM-DD.
    match /plan/{day} {
      allow read: if isMember();
      allow delete: if isMember() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow create, update: if isMember()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isMealOrMissing(request.resource.data, 'lunch')
        && isMealOrMissing(request.resource.data, 'dinner');
    }

    match /ingredients/{key} {
      allow read: if isMember();
      allow write: if isMember()
        && isString(request.resource.data.name, 200)
        && (!('locationId' in request.resource.data)
          || isString(request.resource.data.locationId, 100));
    }

    match /shoppingItems/{itemId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && isString(request.resource.data.name, 200)
        && request.resource.data.checked is bool;
    }

    // One document per ingredient, id = its ingredient key. No amounts means "we have some".
    match /inventory/{key} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && isString(request.resource.data.name, 200)
        && request.resource.data.name.size() > 0
        && request.resource.data.amounts is list
        && request.resource.data.amounts.size() <= 20
        && request.resource.data.always is bool;
    }

    match /cards/{cardId} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && isString(request.resource.data.name, 100)
        && request.resource.data.name.size() > 0
        && request.resource.data.format in ['qr', 'ean13']
        && isString(request.resource.data.value, 1000)
        && request.resource.data.value.size() > 0;
    }

    match /settings/{setting} {
      allow read: if isMember();
      allow write: if isMember() && setting in ['sections', 'shopping', 'locations'];
    }
  }
}
